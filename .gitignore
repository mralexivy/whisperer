# CodeGraph index (generated, ~70MB)
.codegraph/

# Experiment result dumps written to the repo root by ChunkSizeExperimentTests
/*.txt

# Agent scratch worktrees (created by subagents with isolation: worktree)
.claude/worktrees/

# Machine-local symlink some worktrees use to reach the prebuilt static whisper library.
# `whisper.cpp/.gitignore` only ignores `build-*/`, which matches directories, not this link.
whisper.cpp/build-static

# Python bytecode from Tools/ scripts
__pycache__/
*.pyc

# mmBERT training data — all data dirs contain personal dictation, keep out of VCS
Tools/mmbert/data/
Tools/mmbert/data.backup-*/
Tools/mmbert/artifacts/

# graphify knowledge-graph artifacts — generated, rebuild with /graphify
graphify-out/

# Python virtualenvs — machine-specific build output, never source.
# Tools/mmbert/.venv was committed by accident in b35dd0f (8,914 files, 153 MB)
# and its __pycache__/*.pyc churn showed up as ~400 pending changes after every
# run of the mmbert toolchain. Untracked in the commit that added this rule;
# the blobs remain in history, which is a separate call to make.
.venv/
venv/
__pycache__/
*.pyc

# Generated at build time from ~/.whisperer-model-key by Tools/mmbert/gen_key_source.sh.
# The polish-model AES key ships inside the binary by design, but it must not be
# committed: version control is the one place it would outlive a key rotation.
Whisperer/Transcription/Editing/PolishModelKey.generated.swift
Tools/mmbert/lzfse_tool
